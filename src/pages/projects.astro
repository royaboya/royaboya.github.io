---
import Base from "../layouts/Base.astro";

const projects = [
  
  {
    name: "Automation Scripts",
    description: "Scripts I made for automating my personal workflows.",
    stack: "Python",
    url: "https://github.com/royaboya/Automation-Scripts/tree/main",
  },
  {
    name: "File Integrity Monitoring Tool",
    description: "File integrity CLI tooling that I wrote by hand.",
    stack: "Python, argparse, logging, postgreSQL",
    url: "https://github.com/royaboya/File-Integrity-Monitoring",
  },

  {
    name: "DNS Server",
    description: "Simulated DNS Server for my networking class (proj. 6).",
    stack: "Python, Sockets, DNSLib, Threading",
    url: "https://github.com/royaboya/Networking-Fundamentals-4700-Archive/tree/main/project6"

  },
  {
    name: "EXIFT",
    description: "CLI tool to extract EXIF metadata from image files.",
    stack: "Python, argparse, Pillow",
    url: "https://github.com/royaboya/EXIFT",
  },
  {
    name: "Stockington",
    description: "Stocks Analyzer Project for my OOD class back in 2024.",
    stack: "Java, MVC, CSV",
    url: "https://github.com/royaboya/OOD-Stock-Project",
  }
  
  

];
---

<Base title="Projects — Roy Chen" description="Projects by Roy Chen">
  <h1>Projects</h1>
  <p>A few things I've built. Each one links to the source.</p>

  <ul class="project-list">
    {projects.map((p) => (
      <li class="project">
        <h2><a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a></h2>
        <p>{p.description}</p>
        <p class="stack">{p.stack}</p>
      </li>
    ))}
  </ul>

  <style>
    .project-list {
      list-style: none;
      padding: 0;
      margin: 2rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .project {
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .project:last-child {
      border-bottom: none;
    }
    .project h2 {
      margin-bottom: 0.4rem;
      font-size: 1.1rem;
    }
    .stack {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--amber-dim);
    }
  </style>
</Base>
